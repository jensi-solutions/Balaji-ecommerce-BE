<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Verification - <%= appName %></title>
  <style>
    /* Reset & base styling */
    body {
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #f1f5f9;
      -webkit-font-smoothing: antialiased;
    }
    table {
      border-collapse: collapse;
    }
    .wrapper {
      width: 100%;
      background-color: #ffffff;
      padding: 40px 15px;
    }
    .main-card {
      max-width: 560px;
      margin: 0 auto;
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.25), 0 0 20px rgba(244, 63, 94, 0.12);
    }
    /* Brand Header */
    .header-bar {
      background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 50%, #1c1917 100%);
      padding: 32px 24px 26px 24px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .brand-badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 9999px;
      background: rgba(244, 63, 94, 0.12);
      border: 1px solid rgba(244, 63, 94, 0.35);
      color: #fda4af;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .brand-title {
      color: #ffffff;
      font-size: 24px;
      font-weight: 800;
      margin: 0;
      letter-spacing: -0.5px;
    }
    .brand-subtitle {
      color: #fb7185;
      font-size: 12px;
      font-weight: 600;
      margin-top: 4px;
      letter-spacing: 0.5px;
    }
    /* Content Body */
    .content-body {
      padding: 36px 32px 32px 32px;
      text-align: center;
    }
    .headline {
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 12px 0;
    }
    .lead-text {
      font-size: 14px;
      line-height: 1.6;
      color: #94a3b8;
      margin: 0 0 24px 0;
    }
    /* OTP Display Card */
    .otp-container {
      background: linear-gradient(180deg, #182238 0%, #0f172a 100%);
      border: 2px solid #f43f5e;
      border-radius: 16px;
      padding: 22px 28px;
      display: inline-block;
      margin: 6px 0 20px 0;
      box-shadow: 0 10px 25px -5px rgba(244, 63, 94, 0.25);
    }
    .otp-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #fda4af;
      margin-bottom: 8px;
    }
    .otp-digits {
      font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
      font-size: 38px;
      font-weight: 800;
      letter-spacing: 10px;
      color: #fbbf24;
      text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);
      margin: 0;
      padding-left: 10px;
    }
    .timer-pill {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 9999px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fcd34d;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .security-callout {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-left: 4px solid #f43f5e;
      border-radius: 8px;
      padding: 14px 18px;
      text-align: left;
      font-size: 12px;
      line-height: 1.5;
      color: #94a3b8;
      margin-top: 16px;
    }
    .security-callout strong {
      color: #f1f5f9;
    }
    /* Footer */
    .footer-bar {
      background-color: #090d16;
      padding: 22px 24px;
      text-align: center;
      border-top: 1px solid #1e293b;
      font-size: 11px;
      color: #64748b;
      line-height: 1.6;
    }
    .footer-bar a {
      color: #fda4af;
      text-decoration: none;
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #ffffff;">
  <div class="wrapper" style="width: 100%; background-color: #ffffff; padding: 40px 15px;">
    <table class="main-card" cellpadding="0" cellspacing="0" align="center" width="100%" style="max-width: 560px; margin: 0 auto; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 20px; overflow: hidden;">
      <!-- Header -->
      <tr>
        <td class="header-bar">
          <div class="brand-badge">✨ Balaji Cutlery & Cosmetics</div>
          <h1 class="brand-title">Admin Control Panel</h1>
          <div class="brand-subtitle">Security Authentication Service</div>
        </td>
      </tr>

      <!-- Content -->
      <tr>
        <td class="content-body">
          <h2 class="headline">Password Reset Request</h2>
          <p class="lead-text">
            Hello, we received a request to reset the administrator password for your account. Please use the verification code below to proceed:
          </p>

          <!-- OTP Box -->
          <div class="otp-container">
            <div class="otp-label">One-Time Password (OTP)</div>
            <div class="otp-digits"><%= otp %></div>
          </div>
          <br />

          <!-- Expiry Timer -->
          <div class="timer-pill">
            ⏳ Valid for <%= validMinutes %> minutes only
          </div>

          <p class="lead-text" style="font-size: 13px; margin-bottom: 0;">
            If you did not initiate this request, no action is needed. Your account remains completely secure.
          </p>

          <!-- Security Notice -->
          <div class="security-callout">
            <strong>Security Reminder:</strong> Never share this verification code with anyone. Balaji representatives will never ask for your OTP.
          </div>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="footer-bar">
          <p style="margin: 0 0 4px 0;">&copy; <%= year %> <strong>Balaji Cutlery & Cosmetics</strong>. All rights reserved.</p>
          <p style="margin: 0;">Designer Bangles • Bridal Imitation Jewellery • Skincare Cosmetics • Fragrances</p>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
